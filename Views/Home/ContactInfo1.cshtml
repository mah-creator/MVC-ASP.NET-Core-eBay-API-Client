        <!-- Footer -->
        <div class="text-center text-gray-600 border-t border-gray-200 pt-8">
            <p class="mb-2">© 2025 - MVC eBay API Client - Made by 
                <a href="#" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 font-medium">Mahmoud Tahrawi</a>
            </p>
            <p>View the 
                <a href="#" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 font-medium">source code of this project on GitHub</a>.
