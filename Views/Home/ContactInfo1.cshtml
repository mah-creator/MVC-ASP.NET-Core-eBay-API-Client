                                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                            </svg>
                            <a href="mailto:mah.eltahrawi@outlook.com" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 break-all">mah.eltahrawi@outlook.com</a>
                        </div>
